{
  "entities": {
    "Artwork": {
      "title": "Artwork",
      "description": "An artwork item displayed on Artalystic",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artworkCode": { "type": "string" },
        "title": { "type": "string" },
        "artistName": { "type": "string" },
        "artistEmail": { "type": "string" },
        "category": { "type": "string" },
        "medium": { "type": "string" },
        "dimensions": { "type": "string" },
        "year": { "type": "number" },
        "artistNote": { "type": "string" },
        "imageUrl": { "type": "string" },
        "fileType": { "type": "string" },
        "available": { "type": "boolean" },
        "description": { "type": "string" },
        "story": { "type": "string" },
        "featured": { "type": "boolean" },
        "dateAdded": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "artistName", "category", "imageUrl"]
    },
    "EmailRequest": {
      "title": "EmailRequest",
      "description": "Inquiry request for artwork details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artworkId": { "type": "string" },
        "artworkTitle": { "type": "string" },
        "artworkArtist": { "type": "string" },
        "requesterName": { "type": "string" },
        "requesterEmail": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["artworkId", "requesterName", "requesterEmail"]
    },
    "ArtworkEnquiry": {
      "title": "ArtworkEnquiry",
      "description": "Artwork enquiry submitted via Get More Details form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "artworkName": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "artworkName", "message", "status"]
    },
    "ContactEnquiry": {
      "title": "ContactEnquiry",
      "description": "General direct inquiry submitted via Contact Us form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "inquiryTopic": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "inquiryTopic", "message"]
    },
    "ArtistApplication": {
      "title": "ArtistApplication",
      "description": "Artist application for gallery collaboration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "artMedium": { "type": "string" },
        "portfolioUrl": { "type": "string" },
        "portfolioFileUrl": { "type": "string" },
        "artisticStatement": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "artMedium", "artisticStatement", "status"]
    }
  },
  "firestore": {
    "artworks/{artworkId}": {
      "schema": "Artwork",
      "description": "Collection of gallery artworks"
    },
    "email_requests/{requestId}": {
      "schema": "EmailRequest",
      "description": "Inquiries sent by gallery visitors"
    },
    "applications/{applicationId}": {
      "schema": "ArtistApplication",
      "description": "Artist collaboration submissions"
    },
    "artworkEnquiries/{enquiryId}": {
      "schema": "ArtworkEnquiry",
      "description": "Artwork detail enquiry submissions"
    },
    "contactEnquiries/{enquiryId}": {
      "schema": "ContactEnquiry",
      "description": "Contact Us form submissions"
    },
    "artistApplications/{applicationId}": {
      "schema": "ArtistApplication",
      "description": "Artist application form submissions"
    }
  }
}
